{
  "name": "dsh-daily-backup",
  "version": "1.2.9",
  "description": "每天把会话本体、索引、人设、记忆、应用状态各备份一份到工作区外，只保留最近 N 天；左侧栏「备份」能看每天备了哪些文件、管理（手动备份 / 删除某天），第二个页签可直接配网盘推送（OpenList / WebDAV）。备份文件只落在本机或你自己的网盘，不上传第三方。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "backup",
    "session",
    "snapshot",
    "webdav",
    "openlist"
  ],
  "license": "MIT",
  "author": "Maybe-Zero-not-one",
  "type": "module",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  },
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "backup-now.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maybe-Zero-not-one/dsh-daily-backup.git"
  },
  "homepage": "https://github.com/Maybe-Zero-not-one/dsh-daily-backup",
  "bugs": {
    "url": "https://github.com/Maybe-Zero-not-one/dsh-daily-backup/issues"
  }
}
